# PostgreSQL (Railway가 자동 주입)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# 앱-서버 공유 비밀키 (openssl rand -hex 32 로 생성)
API_KEY=your-secret-key-here

# APNS
APNS_TEAM_ID=XXXXXXXXXX
APNS_KEY_ID=XXXXXXXXXX
# .p8 파일 내용을 한 줄로: 개행을 \n 으로 치환
APNS_KEY_P8=-----BEGIN PRIVATE KEY-----\nMIGH...\n-----END PRIVATE KEY-----
APNS_BUNDLE_ID=com.ggpark.BydStats

# FCM (Android, Firebase 프로젝트 준비 후 설정)
# FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
